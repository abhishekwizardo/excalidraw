{
  "appId": "com.excalidraw.local",
  "productName": "Excalidraw Local",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "files": ["desktop/**/*", "excalidraw-app/build/**/*"],
  "mac": {
    "target": ["dmg"]
  },
  "win": {
    "target": ["nsis"]
  },
  "linux": {
    "target": ["AppImage", "deb"]
  }
}
